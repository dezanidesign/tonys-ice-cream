# Optional. Everything works without any of these.

# Canonical site URL (defaults to https://tonysicecream.co.uk).
# Set it on Vercel *Preview* deployments only if you want previews to self-reference.
# NEXT_PUBLIC_SITE_URL=https://tonysicecream.co.uk

# Enquiry form delivery (src/lib/send-enquiry.ts). Create a free API key at https://resend.com,
# verify the sending domain, then add these three variables in the Vercel project settings.
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=tonysicecreams@gmail.com
# ENQUIRY_FROM_EMAIL="Tony's Ice Cream <enquiries@tonysicecream.co.uk>"
